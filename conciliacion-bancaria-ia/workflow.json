    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content ?? '';\nlet txt = String(raw).trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\n\nlet d;\ntry {\n  d = JSON.parse(txt);\n} catch (e) {\n  const m = txt.match(/\\{[\\s\\S]*\\}/);\n  d = m ? JSON.parse(m[0]) : { proveedor: '', importe_total: 0, numero_factura: '' };\n}\n\nreturn [{ json: d }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1232,
        -240
