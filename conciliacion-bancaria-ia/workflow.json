    {
      "parameters": {
        "jsCode": "const factura = $('7A. Parsear JSON').item.json;\nconst filas = $input.all().map(i => i.json);\n\nconst TOLERANCIA = 0.01;\n\nconst coincidencia = filas.find(fila => {\n  const mismoNumero = String(fila.Numero_Factura).trim().toUpperCase() === String(factura.numero_factura).trim().toUpperCase();\n  const importeFila = parseFloat(fila.Importe);\n  const importeFactura = parseFloat(factura.importe_total);\n  const mismoImporte = Math.abs(importeFila - importeFactura) <= TOLERANCIA;\n  return mismoNumero && mismoImporte;\n});\n\nreturn [{\n  json: {\n    proveedor: factura.proveedor,\n    importe_total: factura.importe_total,\n    numero_factura: factura.numero_factura,\n    conciliado: !!coincidencia,\n    row_number: coincidencia ? coincidencia.row_number : null,\n    resultado: coincidencia\n      ? `Factura ${factura.numero_factura} procesada - Conciliado`\n      : `Factura ${factura.numero_factura} procesada - Pendiente (sin match en Banco)`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        -240
      ],
