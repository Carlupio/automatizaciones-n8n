      "parameters": {
        "jsCode": "return [{ json: { requestBody: {\n  model: \"gpt-4o\",\n  messages: [{ role: \"user\", content: [\n    { type: \"file\", file: { filename: \"factura.pdf\", file_data: $json.dataUri } },\n    { type: \"text\", text: \"Extrae de esta factura: proveedor, importe_total (solo numero), numero_factura. Responde EXCLUSIVAMENTE con este JSON: {\\\"proveedor\\\":\\\"...\\\",\\\"importe_total\\\":0,\\\"numero_factura\\\":\\\"...\\\"}\" }\n  ]}]\n}}}];"
      },
