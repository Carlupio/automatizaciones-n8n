    },
    {
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst mime = $input.item.binary.data.mimeType;\nconst base64 = buffer.toString('base64');\nconst dataUri = `data:${mime};base64,${base64}`;\n\nlet tipo = 'otro';\nif (mime.startsWith('image/')) tipo = 'imagen';\nelse if (mime === 'application/pdf') tipo = 'pdf';\nelse if (mime.startsWith('text/')) tipo = 'texto';\n\nreturn [{ json: { ...$json, tipo_archivo: tipo, dataUri }, binary: $input.item.binary }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        -32
      ],
      "id": "741fe60e-58d2-4d94-b825-ed23697802a0",
      "name": "3. Detectar Tipo de Archivo"
    },
